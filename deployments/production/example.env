# Settings of a DataGuard center installation. Copy to .env next to compose.yml
# and fill in; INSTALL.md explains each step. Passwords are not here: prepare.sh
# writes them to files in DG_SECRETS_DIR.

# Image version of dataguard/server.
DG_VERSION=0.1.0

# The address people open in a browser, without a trailing slash, and the
# host port it is published on. The certificate in DG_TLS_DIR must name the host.
DG_PUBLIC_URL=https://dataguard.example.com
DG_DASHBOARD_PORT=443

# Names and addresses agents use to reach the center, comma-separated, and the
# host port for them. They go into the agent endpoint's certificate, issued by
# the center's own CA.
DG_AGENT_HOSTS=dataguard.example.com
DG_AGENT_PORT=8443

# Where prepare.sh keeps the passwords and where the dashboard certificate
# (dashboard.crt with its chain, dashboard.key) lies. Relative to this directory.
DG_SECRETS_DIR=./secrets
DG_TLS_DIR=./tls

# The identity provider. With your own provider, register a public client with
# PKCE (S256), redirect URI ${DG_PUBLIC_URL}/* and the claims described in
# INSTALL.md, then set its issuer and client id here.
DG_OIDC_ISSUER=https://id.example.com/realms/dataguard
DG_OIDC_CLIENT_ID=dataguard-dashboard
# When the provider's certificate comes from your own CA, put that CA into
# DG_TLS_DIR/oidc-ca.crt and set this to /run/secrets/oidc_ca.
DG_OIDC_CA_FILE=

# Only with the bundled Keycloak (profile keycloak): its address, published on
# the same host under DG_KEYCLOAK_PORT. The issuer is then
# ${DG_KEYCLOAK_URL}/realms/dataguard.
DG_PUBLIC_HOST=dataguard.example.com
DG_KEYCLOAK_PORT=8444
DG_KEYCLOAK_URL=https://dataguard.example.com:8444

# The broker runs as one node here, so one copy of each partition. A cluster of
# three nodes, outside this file, takes 3.
DG_BROKER_REPLICATION=1
DG_BROKER_CPUS=1
DG_BROKER_MEMORY=2G

# Where make-free backups land: docker compose --profile backup run --rm backup backup.
DG_BACKUP_DIR=./backup
